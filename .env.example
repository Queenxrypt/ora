# Public Reown project id from https://dashboard.reown.com
# Required for mobile WalletConnect. This is not a secret.
NEXT_PUBLIC_PROJECT_ID=
# Public site origin. Must match the domain allowed on the Reown project.
NEXT_PUBLIC_APP_URL=https://www.useora.site

ORBIO_API_KEY=
ORBIO_REASONING_MODEL=
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ORBIO_MARKET_ORIGIN=https://www.orbio.so
SUPABASE_URL=
SUPABASE_SECRET_KEY=
CRON_SECRET=
OBSERVATION_CADENCE_SECONDS=

# Telegram alerts (server-side only; never NEXT_PUBLIC_).
# Bot token: sends READY alerts and is used by `npm run telegram:webhook`.
TELEGRAM_BOT_TOKEN=
# Bot username without @, for the one-time t.me deep link.
TELEGRAM_BOT_USERNAME=
# 32-256 chars of A-Z a-z 0-9 _ -. Verified on every webhook request.
TELEGRAM_WEBHOOK_SECRET=
# Alert delivery switch. Only "true" sends; keep false until rollout.
TELEGRAM_ALERTS_ENABLED=false
