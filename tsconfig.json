{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "src", "lib/ora/decision.check.ts", "lib/ora/reasoning.check.ts", "lib/ora/outcomes.check.ts", "lib/ora/evaluation.check.ts", "lib/ora/quote-amount.check.ts", "lib/ora/target.check.ts", "lib/ora/target-flow.check.ts", "lib/db/rows.check.ts", "lib/db/ledger-mutation.check.ts", "lib/wallet/connection.check.ts", "lib/orbio/book-observation.check.ts", "lib/ora/observation-history.check.ts", "lib/ora/outcome-engine.check.ts", "lib/ora/performance.check.ts"]
}
